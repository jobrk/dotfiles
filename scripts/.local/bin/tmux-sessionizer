#!/usr/bin/env bash

normalize_path() {
    local path
    path=$(sed 's/^[[:space:]]*//; s/[[:space:]]*$//' <<< "$1")
    case $path in
        ''|\#*) return 1 ;;
        '~') path=$HOME ;;
        '~/'*) path="$HOME/${path#\~/}" ;;
    esac
    [[ -d $path ]] || return 1
    printf '%s\n' "$path"
}

select_directory() {
    local paths_file="$HOME/.config/sessionizer/paths"
    local search_dir
    local search_dirs=()

    if [[ $# -eq 1 ]]; then
        printf '%s\n' "$1"
        return
    fi

    if [[ -f $paths_file ]]; then
        while IFS= read -r search_dir || [[ -n $search_dir ]]; do
            if search_dir=$(normalize_path "$search_dir"); then
                search_dirs+=("$search_dir")
            fi
        done < "$paths_file"
    fi
    [[ ${#search_dirs[@]} -eq 0 ]] && search_dirs=("$HOME")

    for search_dir in "${search_dirs[@]}"; do
        find "$search_dir" -mindepth 1 -maxdepth 1 -type d 2>/dev/null
    done | fzf
}

open_session() {
    local selected=$1
    local session_name
    session_name=$(basename "$selected")
    session_name=${session_name//./_}

    if [[ -z ${TMUX:-} ]]; then
        if tmux has-session -t "=$session_name" 2>/dev/null; then
            exec tmux attach-session -t "=$session_name"
        fi
        exec tmux new-session -s "$session_name" -c "$selected"
    fi

    if ! tmux has-session -t "=$session_name" 2>/dev/null; then
        tmux new-session -ds "$session_name" -c "$selected"
    fi
    tmux switch-client -t "=$session_name"
}

selected=$(select_directory "$@")
[[ -z $selected ]] || open_session "$selected"
