#!/usr/bin/env bash

if [[ $# -eq 1 ]]; then
    selected=$1
else
    paths_file="$HOME/.config/sessionizer/paths"
    search_dirs=()

    if [[ -f $paths_file ]]; then
        while IFS= read -r search_dir || [[ -n $search_dir ]]; do
            search_dir="${search_dir#"${search_dir%%[![:space:]]*}"}"
            search_dir="${search_dir%"${search_dir##*[![:space:]]}"}"
            [[ -z $search_dir || $search_dir == \#* ]] && continue
            [[ $search_dir == '~' ]] && search_dir="$HOME"
            [[ $search_dir == '~/'* ]] && search_dir="$HOME/${search_dir#\~/}"
            [[ -d $search_dir ]] && search_dirs+=("$search_dir")
        done < "$paths_file"
    fi

    [[ ${#search_dirs[@]} -eq 0 ]] && search_dirs=("$HOME")
    selected=$(
        for search_dir in "${search_dirs[@]}"; do
            find "$search_dir" -mindepth 1 -maxdepth 1 -type d 2>/dev/null
        done | fzf
    )
fi

if [[ -z $selected ]]; then
    exit 0
fi

selected_name=$(basename "$selected" | tr . _)

if [[ -z ${TMUX:-} ]]; then
    if tmux has-session -t "=$selected_name" 2>/dev/null; then
        exec tmux attach-session -t "=$selected_name"
    fi
    exec tmux new-session -s "$selected_name" -c "$selected"
fi

if ! tmux has-session -t "=$selected_name" 2>/dev/null; then
    tmux new-session -ds "$selected_name" -c "$selected"
fi

tmux switch-client -t "=$selected_name"
